+/// Authoritative sequence and window state at a quiescent established boundary.
+///
+/// Emitted acknowledgments may still be queued outside this socket. The caller
+/// must separately drain its interface/device and freeze all socket access before
+/// transferring ownership. This is an observation, not a connection capability.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct QuiescentSnapshot {
+    /// Local endpoint of the established tuple.
+    pub local_endpoint: IpEndpoint,
+    /// Remote endpoint of the established tuple.
+    pub remote_endpoint: IpEndpoint,
+    /// First unacknowledged send sequence; equal to `send_next` here.
+    pub send_unacknowledged: TcpSeqNumber,
+    /// Next send sequence after the acknowledged prefix.
+    pub send_next: TcpSeqNumber,
+    /// Next contiguous receive sequence; no unread or assembled bytes remain.
+    pub receive_next: TcpSeqNumber,
+    /// Last acknowledgment emitted to the interface, not confirmed physical I/O.
+    pub last_ack_sent: TcpSeqNumber,
+    /// Last raw window field emitted to the interface.
+    pub last_window_sent: u16,
+    /// Scale applied by the peer to the locally advertised window.
+    pub local_window_shift: u8,
+    /// Scale applied locally to the peer window, or None when not negotiated.
+    pub peer_window_shift: Option<u8>,
+    /// Accepted peer window in bytes, relative to `send_unacknowledged`.
+    pub peer_window_bytes: usize,
+    /// Peer maximum segment size in bytes.
+    pub peer_mss: usize,
+    /// Whether the peer negotiated selective acknowledgments.
+    pub peer_sack_permitted: bool,
+    /// Whether TCP timestamps are enabled; timestamp continuation is not exported.
+    pub timestamps_enabled: bool,
 }
 
