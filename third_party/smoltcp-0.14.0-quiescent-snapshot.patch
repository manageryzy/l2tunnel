+    #[test]
+    fn test_quiescent_snapshot_handshake_and_bidirectional_prefix() {
+        for (capacity, scale, sack) in [(64, None, false), (131_072, Some(7), true)] {
+            let mut s = socket_with_buffer_sizes(64, capacity);
+            s.listen(LOCAL_END).unwrap();
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            send!(
+                s,
+                TcpRepr {
+                    control: TcpControl::Syn,
+                    seq_number: REMOTE_SEQ,
+                    ack_number: None,
+                    window_scale: scale,
+                    sack_permitted: sack,
+                    max_seg_size: Some(1200),
+                    ..SEND_TEMPL
+                }
+            );
+            let mut initial = None;
+            recv(&mut s, Instant::ZERO, |result| {
+                let repr = result.unwrap();
+                assert_eq!(repr.control, TcpControl::Syn);
+                initial = Some(repr.seq_number);
+            });
+            let local = initial.unwrap() + 1;
+            send!(
+                s,
+                TcpRepr {
+                    seq_number: REMOTE_SEQ + 1,
+                    ack_number: Some(local),
+                    window_len: 42,
+                    ..SEND_TEMPL
+                }
+            );
+            let snapshot = s.quiescent_snapshot(Instant::ZERO).unwrap();
+            assert_eq!(snapshot.local_endpoint, LOCAL_END);
+            assert_eq!(snapshot.remote_endpoint, REMOTE_END);
+            assert_eq!(snapshot.send_unacknowledged, local);
+            assert_eq!(snapshot.send_next, local);
+            assert_eq!(snapshot.receive_next, REMOTE_SEQ + 1);
+            assert_eq!(snapshot.last_ack_sent, REMOTE_SEQ + 1);
+            assert_eq!(snapshot.peer_window_shift, scale);
+            assert_eq!(
+                snapshot.local_window_shift,
+                if scale.is_some() { 2 } else { 0 }
+            );
+            assert_eq!(snapshot.peer_window_bytes, 42 << scale.unwrap_or(0));
+            assert_eq!(snapshot.peer_mss, 1200);
+            assert_eq!(snapshot.peer_sack_permitted, sack);
+            assert!(!snapshot.timestamps_enabled);
+            assert_eq!(s.send_slice(b"abc"), Ok(3));
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            recv(&mut s, Instant::ZERO, |result| {
+                assert_eq!(result.unwrap().payload, b"abc");
+            });
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            send!(
+                s,
+                TcpRepr {
+                    seq_number: REMOTE_SEQ + 1,
+                    ack_number: Some(local + 3),
+                    window_len: 43,
+                    payload: b"abcdef",
+                    ..SEND_TEMPL
+                }
+            );
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            recv(&mut s, Instant::ZERO, |result| {
+                assert_eq!(result.unwrap().ack_number, Some(REMOTE_SEQ + 7));
+            });
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            let mut bytes = [0; 6];
+            assert_eq!(s.recv_slice(&mut bytes), Ok(6));
+            assert_eq!(&bytes, b"abcdef");
+            let before = format!("{:?}", s.socket);
+            let snapshot = s.quiescent_snapshot(Instant::ZERO).unwrap();
+            assert_eq!(snapshot.send_next, local + 3);
+            assert_eq!(snapshot.send_unacknowledged, local + 3);
+            assert_eq!(snapshot.receive_next, REMOTE_SEQ + 7);
+            assert_eq!(snapshot.last_ack_sent, REMOTE_SEQ + 7);
+            assert_eq!(
+                snapshot.last_window_sent,
+                ((capacity - 6) >> snapshot.local_window_shift) as u16
+            );
+            assert_eq!(snapshot.peer_window_bytes, 43 << scale.unwrap_or(0));
+            assert_eq!(s.quiescent_snapshot(Instant::ZERO), Some(snapshot));
+            assert_eq!(format!("{:?}", s.socket), before);
+        }
+    }
