+    /// Observe an established socket only when its stream and immediate work are drained.
+    ///
+    /// Returns None for pending bytes, assembly, acknowledgment/window work,
+    /// retransmission/close/probe timers, or due keepalive/timeout work at `now`.
+    /// Callers must poll at the same monotonic time first. This method neither
+    /// advances time nor mutates the socket and cannot prove physical transmission,
+    /// external queue emptiness, application delivery, or safe ownership transfer.
+    pub fn quiescent_snapshot(&self, now: Instant) -> Option<QuiescentSnapshot> {
+        if self.state != State::Established
+            || self.rx_fin_received
+            || !self.tx_buffer.is_empty()
+            || !self.rx_buffer.is_empty()
+            || !self.assembler.is_empty()
+            || self.remote_last_seq != self.local_seq_no
+            || self.remote_last_ack != Some(self.remote_seq_no)
+            || self.ack_delay_timer != AckDelayTimer::Idle
+            || !matches!(self.timer, Timer::Idle { .. })
+            || self.pending_fast_retransmit
+            || self.ack_to_transmit()
+            || self.window_to_update()
+            || self.timer.should_keep_alive(now)
+            || self.timed_out(now)
+        {
+            return None;
+        }
+        let tuple = self.tuple?;
+        Some(QuiescentSnapshot {
+            local_endpoint: tuple.local,
+            remote_endpoint: tuple.remote,
+            send_unacknowledged: self.local_seq_no,
+            send_next: self.remote_last_seq,
+            receive_next: self.remote_seq_no,
+            last_ack_sent: self.remote_last_ack?,
+            last_window_sent: self.remote_last_win,
+            local_window_shift: self.remote_win_shift,
+            peer_window_shift: self.remote_win_scale,
+            peer_window_bytes: self.remote_win_len,
+            peer_mss: self.remote_mss,
+            peer_sack_permitted: self.remote_has_sack,
+            timestamps_enabled: self.timestamp_enabled(),
+        })
+    }
+
