+    #[test]
+    fn test_quiescent_snapshot_rejects_pending_and_due_timers() {
+        for timer in [
+            Timer::Retransmit {
+                expires_at: Instant::from_millis(100),
+            },
+            Timer::FastRetransmit,
+            Timer::ZeroWindowProbe {
+                expires_at: Instant::from_millis(100),
+                delay: Duration::from_millis(50),
+            },
+            Timer::Close {
+                expires_at: Instant::from_millis(100),
+            },
+        ] {
+            let mut s = socket_established();
+            s.timer = timer;
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+        }
+        for timer in [
+            AckDelayTimer::Waiting(Instant::from_millis(100)),
+            AckDelayTimer::Immediate,
+        ] {
+            let mut s = socket_established();
+            s.ack_delay_timer = timer;
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+        }
+        let mut s = socket_established();
+        s.timer = Timer::Idle {
+            keep_alive_at: Some(Instant::from_millis(100)),
+        };
+        assert!(s.quiescent_snapshot(Instant::from_millis(99)).is_some());
+        assert!(s.quiescent_snapshot(Instant::from_millis(100)).is_none());
+        assert!(s.quiescent_snapshot(Instant::from_millis(101)).is_none());
+        s.timer = Timer::new();
+        s.timeout = Some(Duration::from_millis(100));
+        s.remote_last_ts = Some(Instant::ZERO);
+        assert!(s.quiescent_snapshot(Instant::from_millis(99)).is_some());
+        assert!(s.quiescent_snapshot(Instant::from_millis(100)).is_none());
+        assert!(s.quiescent_snapshot(Instant::from_millis(101)).is_none());
+    }
+
+    #[test]
+    fn test_quiescent_snapshot_preserves_advertised_window_and_timestamp_flag() {
+        let mut s = socket_established();
+        s.remote_last_win = 63;
+        let snapshot = s.quiescent_snapshot(Instant::ZERO).unwrap();
+        assert_eq!(snapshot.last_window_sent, 63);
+        // A significant window update is pending; do not invent its transmission.
+        s.remote_last_win = 32;
+        assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+        s.remote_last_win = 64;
+        s.set_tsval_generator(Some(|| 7));
+        assert!(
+            s.quiescent_snapshot(Instant::ZERO)
+                .unwrap()
+                .timestamps_enabled
+        );
+        s.set_tsval_generator(None);
+        assert!(
+            !s.quiescent_snapshot(Instant::ZERO)
+                .unwrap()
+                .timestamps_enabled
+        );
+    }
