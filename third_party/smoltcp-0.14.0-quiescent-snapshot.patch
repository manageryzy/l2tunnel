+    #[test]
+    fn test_quiescent_snapshot_rejects_assembly_without_readable_bytes() {
+        let mut s = socket_established();
+        let reply = send(
+            &mut s,
+            Instant::ZERO,
+            &TcpRepr {
+                seq_number: REMOTE_SEQ + 5,
+                ack_number: Some(LOCAL_SEQ + 1),
+                payload: b"out of order",
+                ..SEND_TEMPL
+            },
+        );
+        assert!(reply.is_some());
+        assert_eq!(s.recv_queue(), 0);
+        assert!(!s.assembler.is_empty());
+        let before = format!("{:?}", s.socket);
+        assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+        assert_eq!(format!("{:?}", s.socket), before);
+    }
+
+    #[test]
+    fn test_quiescent_snapshot_rejects_every_non_established_state() {
+        for state in [
+            State::Closed,
+            State::Listen,
+            State::SynSent,
+            State::SynReceived,
+            State::FinWait1,
+            State::FinWait2,
+            State::Closing,
+            State::TimeWait,
+            State::CloseWait,
+            State::LastAck,
+        ] {
+            let mut s = socket_established();
+            s.state = state;
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none(), "{state:?}");
+        }
+        for alter in [
+            (|s: &mut TestSocket| s.tuple = None) as fn(&mut TestSocket),
+            |s| s.rx_fin_received = true,
+            |s| s.remote_last_seq += 1,
+            |s| s.remote_last_ack = None,
+            |s| s.remote_last_ack = Some(REMOTE_SEQ),
+            |s| s.pending_fast_retransmit = true,
+        ] {
+            let mut s = socket_established();
+            alter(&mut s);
+            let before = format!("{:?}", s.socket);
+            assert!(s.quiescent_snapshot(Instant::ZERO).is_none());
+            assert_eq!(format!("{:?}", s.socket), before);
+        }
+    }
